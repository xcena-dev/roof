    {
      "id": "fabric-note",
      "type": "text",
      "x": 534.5333221435546,
      "y": 1034.9334716796875,
      "width": 1221,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0032",
      "roundness": null,
      "seed": 149330229,
      "version": 1,
      "versionNonce": 1279148376,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790052828190,
      "link": null,
      "locked": false,
      "text": "The fabric admits Host A and Host B whole.\nWorker P, Worker Q and the chat process run on one host under one account,\nso what keeps Q out of the project cache is the region's own permission.",
      "fontSize": 30,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The fabric admits Host A and Host B whole.\nWorker P, Worker Q and the chat process run on one host under one account,\nso what keeps Q out of the project cache is the region's own permission.",
      "autoResize": false,
      "lineHeight": 1.25,
      "syncedAt": "2026-09-22T04:55:08.504Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-09-22T04:55:08.020Z"
