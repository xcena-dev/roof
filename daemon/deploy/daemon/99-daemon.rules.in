# SPDX-License-Identifier: Apache-2.0
# @FS_NAME@ channel device — chown to the daemon account, 0600 perm.
# Applied automatically by udev when @FS_NAME@.ko registers the miscdevice;
# install.sh substitutes accounts.daemon from the config at install time.
KERNEL=="@DAEMON_NAME@-*", OWNER="@DAEMON_USER@", GROUP="@DAEMON_GROUP@", MODE="0600"
